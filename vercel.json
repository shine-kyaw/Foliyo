{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server/index.js" },
    { "source": "/:path*",     "destination": "/index.html" }
  ],
  "functions": {
    "server/index.js": {
      "runtime": "nodejs20.x"
    }
  }
}
