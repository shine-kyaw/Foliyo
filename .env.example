# ── Foliyo API Keys ──────────────────────────────────────────────
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to version control.
# Keys are server-side only — never use VITE_ prefix for these.

# Finnhub — free tier: 60 req/min
# Sign up: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Twelve Data — free tier: 800 credits/day, 8 req/min
# Sign up: https://twelvedata.com/
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Alpha Vantage — free tier: 25 req/day (backup for fundamentals)
# Sign up: https://www.alphavantage.co/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
